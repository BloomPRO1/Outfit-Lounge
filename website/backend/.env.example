# Local dev default: a local Postgres copy restored from the Railway production DB
# (see website/CLAUDE.md — "Local database" section). Percent-encode special
# characters in the password (e.g. "@" -> "%40").
DATABASE_URL=postgresql://postgres:password@localhost:5432/tailorshop_website

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# Website customer auth — generate your own random secret, don't reuse the ERP's
WEBSITE_JWT_SECRET=change-this-to-a-long-random-string
WEBSITE_JWT_EXPIRES_IN=30d
